+		newpath = psprintf("%s/%015" PRIX64, path, segment);
+		if (rename(oldpath, newpath) != 0)
+			pg_fatal("could not rename file \"%s\" to \"%s\": %m", oldpath, newpath);
+		pg_free(oldpath);
+		pg_free(newpath);
+	}
+	closedir(dir);
+	pg_free(path);
+}
