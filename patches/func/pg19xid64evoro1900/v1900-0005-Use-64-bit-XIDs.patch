+# Shift a normal short XID without turning it into a reserved ID or overflowing.
+sub shift_short_xid
+{
+	my ($xid, $delta) = @_;
+	return $xid if $xid < FIRST_NORMAL_TRANSACTION_ID;
+	my $shifted = $xid + $delta;
+	die "rebased tuple XID $shifted does not fit"
+	  if ($shifted < FIRST_NORMAL_TRANSACTION_ID ||
+		$shifted > MAX_SHORT_TRANSACTION_ID);
+	return $shifted;
+}
