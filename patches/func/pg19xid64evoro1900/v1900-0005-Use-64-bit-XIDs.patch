+# Shift a normal short XID without turning it into a reserved ID or overflowing.
+sub shift_short_xid
+{
+	my ($xid, $delta) = @_;
+	return $xid if $xid < FIRST_NORMAL_TRANSACTION_ID;
+	my $shifted = $xid + $delta;
+	die "rebased tuple XID $shifted does not fit"
+	  if ($shifted < FIRST_NORMAL_TRANSACTION_ID ||
+		$shifted > MAX_SHORT_TRANSACTION_ID);
+	return $shifted;
+}
+
+# Move pd_xid_base and pd_multi_base to more suitable positions for tests.
+sub fixup_page
+{
+	my ($fh, $page, $xid_base, $multi_base, $lp_off) = @_;
+	my $offset = $page * HEAPPAGE_SIZE;
+	my $special = read_special_data($fh, $offset);
+
+	die "xid_base $xid_base should be lesser than existed $special->{pd_xid_base}"
+		if ($xid_base > $special->{pd_xid_base});
+	die "multi_base $multi_base should be lesser than existed $special->{pd_multi_base}"
+		if ($multi_base > $special->{pd_multi_base} && $special->{pd_multi_base} != 0);
+	return if ($xid_base == $special->{pd_xid_base} &&
+			$multi_base == $special->{pd_multi_base});
+
+	my $xid_delta = $special->{pd_xid_base} - $xid_base;
+	my $multi_delta = $special->{pd_multi_base} - $multi_base;
+
+	for my $off (@$lp_off)
+	{
+		# Only offsets in this page; this also excludes redirect markers (-1).
+		next if ($off < $offset || $off >= $offset + HEAPPAGE_SIZE);
+		die "tuple at offset $off overlaps page special data"
+		  if $off + HEAPTUPLE_PACK_LENGTH >
+		  $offset + HEAPPAGE_SIZE - HEAPPAGE_SPECIAL_PACK_LENGTH;
+
+		my $tup = read_tuple($fh, $off, 1);
+		$tup->{t_xmin} = shift_short_xid($tup->{t_xmin}, $xid_delta);
+		my $is_multi = $tup->{t_infomask} & HEAP_XMAX_IS_MULTI;
+		$tup->{t_xmax} = shift_short_xid($tup->{t_xmax},
+			$is_multi ? $multi_delta : $xid_delta);
+		write_tuple($fh, $off, $tup, 1);
+	}
+
+	# A normal pruning hint is relative to pd_xid_base, just like tuple XIDs.
+	# Match HeapPageSetPruneXid's conservative hint if the exact value won't fit.
+	my $hint_offset = $offset + HEAPPAGE_PRUNE_XID_OFFSET;
+	sysseek($fh, $hint_offset, 0)
+	  or BAIL_OUT("sysseek failed: $!");
+	my $hint_buffer;
+	my $read = sysread($fh, $hint_buffer, 4);
+	defined($read) && $read == 4 or BAIL_OUT("could not read pruning hint: $!");
+	my $hint = unpack('L', $hint_buffer);
+	if ($hint >= FIRST_NORMAL_TRANSACTION_ID)
+	{
+		$hint += $xid_delta;
+		$hint = FROZEN_TRANSACTION_ID if $hint > MAX_SHORT_TRANSACTION_ID;
+	}
+	sysseek($fh, $hint_offset, 0)
+	  or BAIL_OUT("sysseek failed: $!");
+	my $written = syswrite($fh, pack('L', $hint), 4);
+	defined($written) && $written == 4
+	  or BAIL_OUT("could not write pruning hint: $!");
+
+	$special->{pd_xid_base} = $xid_base;
+	$special->{pd_multi_base} = $multi_base;
+
+	write_special_data($fh, $offset, $special);
+}
