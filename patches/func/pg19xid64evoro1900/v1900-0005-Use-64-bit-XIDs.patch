+		# Only offsets in this page; this also excludes redirect markers (-1).
+		next if ($off < $offset || $off >= $offset + HEAPPAGE_SIZE);
+		die "tuple at offset $off overlaps page special data"
+		  if $off + HEAPTUPLE_PACK_LENGTH >
+		  $offset + HEAPPAGE_SIZE - HEAPPAGE_SPECIAL_PACK_LENGTH;
+
+		my $tup = read_tuple($fh, $off, 1);
+		$tup->{t_xmin} = shift_short_xid($tup->{t_xmin}, $xid_delta);
+		my $is_multi = $tup->{t_infomask} & HEAP_XMAX_IS_MULTI;
+		$tup->{t_xmax} = shift_short_xid($tup->{t_xmax},
+			$is_multi ? $multi_delta : $xid_delta);
