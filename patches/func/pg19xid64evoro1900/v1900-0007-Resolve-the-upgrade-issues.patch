+/*
+ * Convert heap/toast page into 64-xid format.
+ *
+ */
+static void
+convert_page_internal(RelationExtraData *rel_extra, RelFileLocator *relfilelocator,
+					  ForkNumber forknumber, Page page, Buffer buf,
+					  BlockNumber blkno)
+{
+	PageHeader	hdr = (PageHeader) page;
+	bool		try_double_xmax;
+
+	Assert(rel_extra != NULL);
+	/* Accept only the relation kinds handled by the conversion switch below. */
+	Assert(rel_extra->relkind == RELKIND_RELATION ||
+		   rel_extra->relkind == RELKIND_INDEX ||
+		   rel_extra->relkind == RELKIND_SEQUENCE ||
+		   rel_extra->relkind == RELKIND_TOASTVALUE ||
+		   rel_extra->relkind == RELKIND_MATVIEW ||
+		   rel_extra->relkind == RELKIND_PARTITIONED_TABLE);
+
+	switch (rel_extra->relkind)
+	{
+		case RELKIND_TOASTVALUE:
+			try_double_xmax = hdr->pd_upper - hdr->pd_lower <
+									MAXALIGN(sizeof(ToastPageSpecialData));
+			repack_heap_tuples(rel_extra, relfilelocator, forknumber, page, buf, blkno, try_double_xmax);
+			break;
+		case RELKIND_RELATION:
+		case RELKIND_PARTITIONED_TABLE:
+		case RELKIND_MATVIEW:
+			try_double_xmax = hdr->pd_upper - hdr->pd_lower <
+									MAXALIGN(sizeof(HeapPageSpecialData));
+			repack_heap_tuples(rel_extra, relfilelocator, forknumber, page, buf, blkno, try_double_xmax);
+			break;
+		case RELKIND_INDEX:
+			/* no need to convert index */
+		case RELKIND_SEQUENCE:
+			/* no real need to convert sequences */
+			break;
+		default:
+			ereport(ERROR,
+					(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+					 errmsg("conversion for blkno %u, relation \"%s\" cannot be done",
+							blkno,
+							relpathperm(*relfilelocator, forknumber).str),
+					 errdetail_relkind_not_supported(rel_extra->relkind)));
+	}
+
+	hdr->pd_checksum = pg_checksum_page((char *) page, blkno);
+
+	PageSetPageSizeAndVersion(page, PageGetPageSize(page),
+							  PG_PAGE_LAYOUT_VERSION);
+}
