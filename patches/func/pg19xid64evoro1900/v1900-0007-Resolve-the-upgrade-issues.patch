+/*
+ * Finish a legacy read that cannot be converted in shared AIO completion.
+ * BM_CONVERSION_PENDING is published atomically with BM_VALID and is cleared
+ * only after the full page has been installed.  The page version must not be
+ * used as an unlocked completion test: a memcpy may expose its header first.
+ * Permanent pages log their conversion image before readiness is published.
+ * BM_CONVERSION_NEEDS_WAL preserves the first-image obligation on paths that
+ * cannot insert WAL.  Readers serialize on the content lock, and a failed
+ * private conversion leaves the shared page unchanged for retry.
+ */
+static void
+FinishReadBufferConversion(ReadBuffersOperation *operation, Buffer buffer)
+{
+	BufferDesc *bufHdr;
+	Page		page;
+	RelationExtraData rel_extra;
+	RelFileLocator locator;
+	ForkNumber forknum;
+	BlockNumber blocknum;
+	PGAlignedBlock copy;
+	bool		permanent;
+	bool		log_conversion;
+
+	if (BufferIsLocal(buffer))
+		return;
+	bufHdr = GetBufferDescriptor(buffer - 1);
+	if (!(pg_atomic_read_u64(&bufHdr->state) & BM_CONVERSION_PENDING))
+	{
+		/* Acquire page bytes published before the pending-bit clear. */
+		pg_read_barrier();
+		return;
+	}
+
+	LockBuffer(buffer, BUFFER_LOCK_EXCLUSIVE);
+	if (!(pg_atomic_read_u64(&bufHdr->state) & BM_CONVERSION_PENDING))
+	{
+		LockBuffer(buffer, BUFFER_LOCK_UNLOCK);
+		return;
+	}
+	page = BufferGetPage(buffer);
+	/* An explicit overwrite/FPI may have replaced the legacy contents. */
+	if (PageIsNew(page) ||
+		PageGetPageLayoutVersion(page) == PG_PAGE_LAYOUT_VERSION)
+	{
+		pg_atomic_fetch_and_u64(&bufHdr->state, ~BM_CONVERSION_PENDING);
+		LockBuffer(buffer, BUFFER_LOCK_UNLOCK);
+		return;
+	}
+	Assert(CritSectionCount == 0);
+	BufferGetTag(buffer, &locator, &forknum, &blocknum);
+	if (PageGetPageLayoutVersion(page) != PG_PAGE_LAYOUT_VERSION - 1)
+		ereport(ERROR,
+				(errcode(ERRCODE_DATA_CORRUPTED),
+				 errmsg("unsupported page version %u in block %u of relation %s",
+						PageGetPageLayoutVersion(page), blocknum,
+						relpathperm(locator, forknum).str)));
+	if (operation->rel)
+	{
+		rel_extra.relfrozenxid = operation->rel->rd_rel->relfrozenxid;
+		rel_extra.relminmxid = operation->rel->rd_rel->relminmxid;
+		rel_extra.relkind = operation->rel->rd_rel->relkind;
+	}
+	else
+		rel_extra = operation->rel_extra;
+	if (forknum != MAIN_FORKNUM || rel_extra.relkind == RELKIND_UNKNOWN)
+		ereport(ERROR,
+				(errcode(ERRCODE_DATA_CORRUPTED),
+				 errmsg("cannot convert legacy block %u of relation %s without heap conversion metadata",
+						blocknum, relpathperm(locator, forknum).str)));
+
+	memcpy(copy.data, page, BLCKSZ);
+	convert_page(&rel_extra, &locator, forknum, copy.data, buffer, blocknum);
+	permanent = BufferIsPermanent(buffer);
+	log_conversion = permanent && XLogInsertAllowed() &&
+		!RelFileLocatorSkippingWAL(locator);
+	/*
+	 * Prepare the forced image before changing shared bytes.  In particular,
+	 * an invalid WAL insertion context must fail outside the critical section.
+	 * Register the private copy: it remains stable until XLogInsert finishes.
+	 */
+	if (log_conversion)
+	{
+		XLogBeginInsert();
+		XLogRegisterBlock(0, &locator, forknum, blocknum, copy.data,
+						 REGBUF_FORCE_IMAGE | REGBUF_STANDARD);
+	}
+	INJECTION_POINT_LOAD("buffer-conversion-header-published");
+	START_CRIT_SECTION();
+	/* Expose a legal partial-copy interleaving to concurrency tests. */
+#ifdef USE_INJECTION_POINTS
+	memcpy(page, copy.data, SizeOfPageHeaderData);
+	INJECTION_POINT_CACHED("buffer-conversion-header-published", &buffer);
+	memcpy((char *) page + SizeOfPageHeaderData,
+		   copy.data + SizeOfPageHeaderData, BLCKSZ - SizeOfPageHeaderData);
+#else
+	memcpy(page, copy.data, BLCKSZ);
+#endif
+	/*
+	 * Dirty before WAL insertion so a concurrent checkpoint cannot miss the
+	 * format change.  The exclusive content lock prevents flushing until the
+	 * image and its LSN are installed.  A crash then replays conversion even
+	 * if the first access was a read with no hint updates.
+	 */
+	if (log_conversion || !permanent)
+		MarkBufferDirty(buffer);
+	if (log_conversion)
+		PageSetLSN(page, XLogInsert(RM_XLOG_ID, XLOG_FPI));
+	/*
+	 * Recovery and permanent relations skipping WAL retain a clean converted
+	 * page and its WAL obligation.  Their existing overwrite/first-write paths
+	 * must discharge that obligation before the page becomes durable.
+	 */
+	/* Full-barrier atomic publication; fast readers never inspect half a copy. */
+	pg_atomic_fetch_and_u64(&bufHdr->state,
+							~(BM_CONVERSION_PENDING |
+							  ((log_conversion || !permanent) ?
+							   BM_CONVERSION_NEEDS_WAL : 0)));
+	END_CRIT_SECTION();
+	LockBuffer(buffer, BUFFER_LOCK_UNLOCK);
+}
