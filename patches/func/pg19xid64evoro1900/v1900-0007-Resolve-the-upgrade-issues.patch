+	ALTER TABLE recovery_dense ALTER COLUMN payload SET STORAGE PLAIN;
+	INSERT INTO recovery_dense SELECT n, repeat('x',4048) FROM generate_series(1,2) n;
+});
+$old->safe_psql('postgres', 'VACUUM FREEZE recovery_dense');
+$old->safe_psql('postgres', q{
+	CREATE TABLE recovery_dense_unfrozen(n int, payload text);
+	ALTER TABLE recovery_dense_unfrozen ALTER COLUMN payload SET STORAGE PLAIN;
+	INSERT INTO recovery_dense_unfrozen SELECT n, repeat('y',4048) FROM generate_series(1,2) n;
+	CREATE TABLE recovery_bad(n int);
+	INSERT INTO recovery_bad VALUES (1);
+	CREATE TABLE recovery_hint(n int);
+	INSERT INTO recovery_hint VALUES (1);
+	CREATE TABLE recovery_safe_row(value recovery_update);
+	INSERT INTO recovery_safe_row VALUES (ROW(1));
+	CREATE TYPE bad_xid_record AS (value xid);
+	CREATE TABLE bad_xid_storage(direct xid, elements xid[], nested bad_xid_record);
+});
+$old->stop;
+# The epoch belongs to control data, not to source 32-bit CLOG addresses.
+$old->command_ok([$old->installed_command('pg_resetwal'), '-e', '1',
+	'--pgdata' => $old->data_dir], 'set a nonzero source XID epoch');
+
+my $primary = PostgreSQL::Test::Cluster->new('recovery_primary');
+$primary->init(allows_streaming => 1, extra => ['--no-data-checksums']);
+$primary->append_conf('postgresql.conf', qq{
+autovacuum = off
+autovacuum_freeze_max_age = 1000000000000
+autovacuum_multixact_freeze_max_age = 1000000000000
+full_page_writes = off
+wal_log_hints = off
+io_method = worker
+checkpoint_timeout = '1h'
+});
+$primary->start;
+my $xid_size = $primary->safe_psql('postgres',
+	q{SELECT typlen FROM pg_type WHERE oid = 'xid'::regtype});
+$primary->stop;
+plan skip_all => 'target cluster must use xid64' unless $xid_size eq '8';
+
+my @upgrade_command = (
+	$primary->installed_command('pg_upgrade'), '--no-sync', '--copy',
+	'--old-datadir' => $old->data_dir,
+	'--new-datadir' => $primary->data_dir,
+	'--old-bindir' => $old->config_data('--bindir'),
+	'--new-bindir' => $primary->config_data('--bindir'),
+	'--socketdir' => $primary->host,
+	'--old-port' => $old->port,
+	'--new-port' => $primary->port);
+ok(!run_log([@upgrade_command, '--check']), 'reject explicit user xid storage');
+my @reports = glob($primary->data_dir . '/pg_upgrade_output.d/*/tables_using_xid.txt');
+BAIL_OUT('missing xid usage report') unless @reports;
+my $report = slurp_file($reports[-1]);
+like($report, qr/bad_xid_storage\.direct/, 'report direct user xid column');
+like($report, qr/bad_xid_storage\.elements/, 'report array of xid');
+like($report, qr/bad_xid_storage\.nested/, 'report composite containing xid');
+unlike($report, qr/\.(?:xmin|xmax)\b|recovery_safe_row/,
+	'ignore system XIDs and safe row types during recursive type checks');
+$old->start;
+$old->safe_psql('postgres', 'DROP TABLE bad_xid_storage; DROP TYPE bad_xid_record');
+$old->stop;
+my $upgraded = run_log([@upgrade_command]);
+ok($upgraded, 'upgrade source cluster for recovery tests');
+BAIL_OUT('upgrade failed') unless $upgraded;
+
+$primary->start;
+$primary->safe_psql('postgres', 'CREATE EXTENSION pg_visibility');
+$primary->safe_psql('postgres', 'CREATE EXTENSION pg_walinspect');
+my $regresslib = $ENV{REGRESS_SHLIB};
+BAIL_OUT('REGRESS_SHLIB is required') unless defined $regresslib;
+$regresslib =~ s/'/''/g;
+$primary->safe_psql('postgres', qq{
+	CREATE FUNCTION test_xid64_extension_fallback(regclass) RETURNS int4
+	AS '$regresslib' LANGUAGE C STRICT;
+});
+# A supported way to invalidate the VM without reading/converting heap pages.
+# Tuples are already frozen, so the next VACUUM only needs visibility WAL.
+$primary->safe_psql('postgres',
+	q{SELECT pg_truncate_visibility_map('recovery_visible')});
+my %paths;
+for my $table ('recovery_update', 'recovery_extend', 'recovery_visible',
+	'recovery_dense', 'recovery_dense_unfrozen', 'recovery_hint', 'recovery_bad',
+	'recovery_read_only')
+{
+	$paths{$table} = $primary->safe_psql('postgres',
+		"SELECT pg_relation_filepath('$table')");
+}
+$primary->stop;
+
+sub page_version
+{
+	my ($path) = @_;
+	open(my $fh, '<:raw', $path) or die "open $path: $!";
+	seek($fh, 18, 0) or die "seek $path: $!";
+	read($fh, my $bytes, 2) == 2 or die "read page version from $path: $!";
+	close($fh);
+	return unpack('S', $bytes) & 0xff;
+}
+for my $table (sort keys %paths)
+{
+	is(page_version($primary->data_dir . '/' . $paths{$table}), 4,
+		"$table still has an old-format page before replay");
+}
+
+# AIO completion must not PANIC on a conversion error.  Corrupt only t_hoff;
+# the physical page header remains valid, so this reaches legacy conversion.
+my $bad_path = $primary->data_dir . '/' . $paths{recovery_bad};
+my $bad_bytes = slurp_file($bad_path);
+my $tuple_offset = unpack('S', substr($bad_bytes, 14, 2));
+my $header_offset = $tuple_offset + 22; # offsetof(HeapTupleHeaderData, t_hoff)
+open(my $bad_fh, '+<:raw', $bad_path) or die "open $bad_path: $!";
+seek($bad_fh, $header_offset, 0) or die "seek $bad_path: $!";
+print $bad_fh "\0";
+close($bad_fh);
+$primary->start;
+for my $attempt (1 .. 2)
+{
+	my ($ret, $out, $err) = $primary->psql('postgres',
+		'SELECT n FROM recovery_bad');
+	is($ret, 3, "conversion error is a normal SQL failure (attempt $attempt)");
+	like($err, qr/invalid legacy tuple header/,
+		"conversion retries the unchanged legacy page (attempt $attempt)");
+}
+is($primary->safe_psql('postgres', 'SELECT 1'), '1',
+	'server remains available after legacy conversion errors');
+$primary->stop;
+open($bad_fh, '+<:raw', $bad_path) or die "open $bad_path: $!";
+seek($bad_fh, $header_offset, 0) or die "seek $bad_path: $!";
+print $bad_fh substr($bad_bytes, $header_offset, 1);
+close($bad_fh);
+$primary->start;
+is($primary->safe_psql('postgres', 'SELECT n FROM recovery_bad'), '1',
+	'repaired legacy page converts successfully after restart');
+$primary->stop;
+
+$primary->backup_fs_cold('upgraded');
+my $standby = PostgreSQL::Test::Cluster->new('recovery_standby');
+$standby->init_from_backup($primary, 'upgraded', has_streaming => 1);
+# Exercise XLogReadBufferExtended's missing-block extension branch when the
+# update's full-page image arrives. No old heap contents are needed here.
+my $extend_path = $standby->data_dir . '/' . $paths{recovery_extend};
+truncate($extend_path, 0) or die "truncate $extend_path: $!";
+$primary->start;
+$standby->start;
+
+# Frozen tuples already have their visibility hints.  The read itself must
+# emit exactly one conversion FPI, before any UPDATE, hint write or VACUUM.
+my $read_start = $primary->safe_psql('postgres', 'SELECT pg_current_wal_insert_lsn()');
+is($primary->safe_psql('postgres', 'SELECT n FROM recovery_read_only'), '1',
+	'read a frozen legacy page without modifying tuple hints');
+my $read_end = $primary->safe_psql('postgres', 'SELECT pg_current_wal_insert_lsn()');
+# Flush the inspected interval; this does not modify the test relation.
+$primary->safe_psql('postgres', 'SELECT pg_switch_wal()');
+is($primary->safe_psql('postgres', qq{
+	SELECT count(*) FROM pg_get_wal_block_info('$read_start', '$read_end', false)
+	WHERE relfilenode = pg_relation_filenode('recovery_read_only')
+	  AND reldatabase = (SELECT oid FROM pg_database WHERE datname = current_database())
+	  AND relforknumber = 0 AND relblocknumber = 0
+	  AND resource_manager = 'XLOG' AND record_type = 'FPI'
+	  AND block_fpi_length > 0
+}), '1', 'read-only conversion immediately emits one full-page WAL image');
+$primary->wait_for_catchup($standby);
+is($standby->safe_psql('postgres', 'SELECT n FROM recovery_read_only'), '1',
+	'conversion image alone makes the legacy page readable on the standby');
+
+# A hint-only read must WAL-log conversion even without checksums/hint WAL.
+# Restart loses the in-memory conversion marker; a subsequent incremental
+# update must therefore find an already converted page on the standby.
+is($primary->safe_psql('postgres', 'SELECT n FROM recovery_hint'), '1',
+	'hint-only read of a legacy page succeeds');
+$primary->safe_psql('postgres', 'CHECKPOINT');
+$primary->stop;
+is(page_version($primary->data_dir . '/' . $paths{recovery_hint}), 5,
+	'hint dirtied the converted page before restart');
+$primary->start;
+$primary->safe_psql('postgres', 'UPDATE recovery_hint SET n = 2');
+$primary->wait_for_catchup($standby);
+is($standby->safe_psql('postgres', 'SELECT n FROM recovery_hint'), '2',
+	'incremental update after hint/checkpoint/restart replays on legacy standby');
+
+$primary->safe_psql('postgres', q{
+	UPDATE recovery_update SET n = 2;
+	UPDATE recovery_extend SET n = 2;
+	UPDATE recovery_dense SET n = n + 1;
+	UPDATE recovery_dense_unfrozen SET n = n + 1;
+});
+$primary->wait_for_catchup($standby);
+is($standby->safe_psql('postgres', 'SELECT n FROM recovery_update'), '2',
+	'replay restores converted heap despite full_page_writes=off');
+is($standby->safe_psql('postgres', 'SELECT n FROM recovery_extend'), '2',
+	'replay extends missing heap and restores converted page');
+is($standby->safe_psql('postgres', 'SELECT sum(n) FROM recovery_dense'), '5',
+	'dense legacy conversion and double-xmax update replay correctly');
+is($standby->safe_psql('postgres', 'SELECT sum(n) FROM recovery_dense_unfrozen'), '5',
+	'dense legacy conversion can check commit status in the reading backend');
+# Subsequent records use the normal relcache-less read path on current pages.
+$standby->stop;
+$primary->safe_psql('postgres', q{
+	UPDATE recovery_update SET n = 3;
+	UPDATE recovery_extend SET n = 3;
+});
+$standby->start;
+$primary->wait_for_catchup($standby);
+is($standby->safe_psql('postgres', 'SELECT n FROM recovery_update'), '3',
+	'incremental redo reads converted page without relcache after restart');
+
+# Force the generic extension fallback on an already existing replayed block.
+# Recovery itself is the only writer and normally extends missing blocks
+# directly; this helper explicitly selects BMR_SMGR and the no-extension path.
+$standby->stop;
+$standby->start;
+is($standby->safe_psql('postgres',
+	q{SELECT test_xid64_extension_fallback('recovery_extend')}), '5',
+	'relcache-less extension fallback reads a replayed page after restart');
+
+$primary->safe_psql('postgres',
+	'VACUUM (DISABLE_PAGE_SKIPPING) recovery_visible');
+$primary->wait_for_catchup($standby);
+is($standby->safe_psql('postgres', 'SELECT n FROM recovery_visible'), '1',
+	'visibility WAL restores converted heap with checksums and hints disabled');
+$standby->stop;
+$primary->stop;
+done_testing();
diff --git a/src/bin/pg_upgrade/t/010_xid32_to_xid64_createdb.pl b/src/bin/pg_upgrade/t/010_xid32_to_xid64_createdb.pl
new file mode 100644
index 00000000000..60229a5f398
--- /dev/null
+++ b/src/bin/pg_upgrade/t/010_xid32_to_xid64_createdb.pl
@@ -0,0 +1,135 @@
+# Copyright (c) 2026, Tantor Labs
+# CREATE DATABASE must pass source pg_class metadata to backend conversion.
+use strict;
+use warnings FATAL => 'all';
+
+use PostgreSQL::Test::Cluster;
+use PostgreSQL::Test::Utils;
+use Test::More;
+
+plan skip_all => 'oldinstall is required for xid32 to xid64 test'
+  unless defined $ENV{oldinstall};
+
+my $oldnode = PostgreSQL::Test::Cluster->new(
+	'createdb_old', install_path => $ENV{oldinstall});
+$oldnode->init(force_initdb => 1, xid32 => 1);
+$oldnode->append_conf('postgresql.conf', 'autovacuum = off');
+$oldnode->start;
+plan skip_all => 'source cluster must use xid32'
+  unless $oldnode->safe_psql('postgres',
+	q{SELECT typlen FROM pg_type WHERE oid = 'xid'::regtype}) eq '4';
+
+# PG18 enables checksums by default; older sources may need enabling.
+if ($oldnode->safe_psql('postgres', 'SHOW data_checksums') eq 'off')
+{
+	$oldnode->stop;
+	$oldnode->command_ok([
+		$oldnode->installed_command('pg_checksums'), '--enable', '--no-sync',
+		'--pgdata' => $oldnode->data_dir
+	], 'enable source checksums to match the target cluster');
+	$oldnode->start;
+}
+
+my $newnode = PostgreSQL::Test::Cluster->new('createdb_new');
+$newnode->init;
+$newnode->append_conf('postgresql.conf', qq{
+autovacuum = off
+autovacuum_freeze_max_age = 1000000000000
+autovacuum_multixact_freeze_max_age = 1000000000000
+});
+$newnode->start;
+my $target_size = $newnode->safe_psql('postgres',
+	q{SELECT typlen FROM pg_type WHERE oid = 'xid'::regtype});
+$newnode->stop;
+plan skip_all => 'target cluster must use xid64' unless $target_size eq '8';
+
+# Each case gets an independent source database, keeping its old-format
+# physical pages untouched by reads performed in the preceding case.
+my @cases;
+for my $method ('sync', 'worker')
+{
+	for my $strategy ('WAL_LOG', 'FILE_COPY')
+	{
+		my $source = 'source_' . $method . '_' . lc($strategy);
+		push @cases, [$method, $strategy, $source];
+		$oldnode->safe_psql('postgres', "CREATE DATABASE $source");
+		$oldnode->safe_psql($source, q{
+			CREATE TABLE payload (id int PRIMARY KEY, body text);
+			ALTER TABLE payload ALTER COLUMN body SET STORAGE EXTERNAL;
+			INSERT INTO payload
+				SELECT g, repeat(md5(g::text), 400) FROM generate_series(1, 30) g;
+			CREATE MATERIALIZED VIEW summary AS SELECT count(*) AS n FROM payload;
+			CREATE SEQUENCE seq;
+			CREATE UNLOGGED TABLE unlogged_payload AS SELECT 42 AS n;
+			SELECT lo_from_bytea(90001, decode(repeat('ab', 16000), 'hex'));
+			CHECKPOINT;
+		});
+	}
+}
+
+# Prepare template1 for the default CREATE DATABASE command below.
+# Store a large object and flush its pg_largeobject pages to disk before
+# upgrade. pg_upgrade physically transfers those old-format pages, while
+# reconstructing pg_class in the new format. Later, CREATE DATABASE default_copy
+# uses template1 by default and reads these pages through the WAL_LOG copy path,
+# triggering conversion without relcache.
+$oldnode->safe_psql('template1', q{
+	SELECT lo_from_bytea(90002, decode(repeat('cd', 8000), 'hex'));
+	CHECKPOINT;
+});
+$oldnode->stop;
+
+command_ok([
+	$newnode->installed_command('pg_upgrade'), '--no-sync',
+	'--old-datadir' => $oldnode->data_dir,
+	'--new-datadir' => $newnode->data_dir,
+	'--old-bindir' => $oldnode->config_data('--bindir'),
+	'--new-bindir' => $newnode->config_data('--bindir'),
+	'--socketdir' => $newnode->host,
+	'--old-port' => $oldnode->port,
+	'--new-port' => $newnode->port,
+	$ENV{PG_TEST_PG_UPGRADE_MODE} || '--copy'
+], 'upgrade cluster with large objects in template1 and custom templates');
+
+$newnode->append_conf('postgresql.conf', 'io_method = worker');
+$newnode->start;
+my ($ret, $stdout, $stderr) = $newnode->psql('postgres',
+	'CREATE DATABASE default_copy');
+is($ret, 0, 'default CREATE DATABASE converts upgraded template1 large objects')
+  or diag("stdout:\n$stdout\nstderr:\n$stderr");
+if ($ret == 0)
+{
+	is($newnode->safe_psql('default_copy',
+		q{SELECT lo_get(90002) = decode(repeat('cd', 8000), 'hex')}),
+		't', 'default database preserves template1 large object');
+}
+
+for my $case (@cases)
+{
+	my ($method, $strategy, $source) = @$case;
+	my $destination = $source . '_copy';
+	# Clear shared_buffers so a prior cache hit cannot mask missing context.
+	$newnode->stop;
+	$newnode->append_conf('postgresql.conf', "io_method = $method");
+	$newnode->start;
+	($ret, $stdout, $stderr) = $newnode->psql('postgres',
+		"CREATE DATABASE $destination TEMPLATE $source STRATEGY $strategy");
+	is($ret, 0, "CREATE DATABASE $strategy with io_method=$method")
+	  or diag("stdout:\n$stdout\nstderr:\n$stderr");
+	next if $ret != 0;
+	is($newnode->safe_psql($destination, q{
+		SELECT count(*), bool_and(body = repeat(md5(id::text), 400)) FROM payload;
+		SELECT lo_get(90001) = decode(repeat('ab', 16000), 'hex');
+		SELECT n FROM summary;
+		SELECT nextval('seq');
+		SELECT n FROM unlogged_payload;
+	}), "30|t\nt\n30\n1\n42", 'heap, TOAST, large object, matview, sequence and unlogged data survive');
+	# Check persistence, rather than just the newly populated buffer cache.
+	$newnode->stop;
+	$newnode->start;
+	is($newnode->safe_psql($destination,
+		q{SELECT lo_get(90001) = decode(repeat('ab', 16000), 'hex')}),
+		't', 'copied large object remains readable after restart');
+}
+$newnode->stop;
+done_testing();
diff --git a/src/bin/pg_upgrade/t/011_xid32_to_xid64_double_xmax.pl b/src/bin/pg_upgrade/t/011_xid32_to_xid64_double_xmax.pl
new file mode 100644
index 00000000000..aad41b1fdf8
--- /dev/null
+++ b/src/bin/pg_upgrade/t/011_xid32_to_xid64_double_xmax.pl
@@ -0,0 +1,216 @@
+# Copyright (c) 2026, Tantor Labs
+#
+# TTDB-2707: 32-bit -> 64-bit XID upgrade leaves duplicate PRIMARY KEY rows
+# after UPDATE + VACUUM.
+#
+# When a 32-bit XID cluster is converted to the 64-bit XID format, a heap page
+# that has less than MAXALIGN(sizeof(HeapPageSpecialData)) bytes of free space
+# cannot hold the page special area, so it is converted to the "double xmax"
+# layout instead.  A double xmax page reports pd_special == BLCKSZ; its tuples
+# no longer store a short xmin at all -- t_xmin and t_xmax are reused to keep
+# the full 64-bit xmax and the xmin is implicitly frozen.
+#
+# HeapTupleSatisfiesVacuumHorizon() guarded HeapTupleCopyXidsFromPage() with
+# "if (PageGetSpecialSize(page))", intending to skip only unconverted 32-bit
+# pages.  A double xmax page reports PageGetSpecialSize() == 0 as well, so its
+# tuple XIDs were never decoded: t_xmin/t_xmax were left at whatever the caller
+# had.  VACUUM therefore resolved the updating XID from a bogus value, decided
+# the (committed) update had aborted, set HEAP_XMAX_INVALID and kept the
+# superseded tuple as HEAPTUPLE_LIVE.  Both row versions stay visible, which
+# shows up as duplicated PRIMARY KEY values.
+#
+# A SELECT between UPDATE and VACUUM hides the bug: the MVCC path does decode
+# double xmax pages, so it records HEAP_XMAX_COMMITTED and VACUUM no longer
+# has to resolve the status itself.
+
+use strict;
+use warnings FATAL => 'all';
+
+use PostgreSQL::Test::Cluster;
+use PostgreSQL::Test::Utils;
+use Test::More;
+
+plan skip_all => 'oldinstall is required for xid32 to xid64 test'
+  unless defined $ENV{oldinstall};
+
+my $mode = $ENV{PG_TEST_PG_UPGRADE_MODE} || '--copy';
+
+my $oldnode = PostgreSQL::Test::Cluster->new(
+	'dxmax_old',
+	install_path => $ENV{oldinstall});
+
+$oldnode->init(
+	force_initdb => 1,
+	xid32 => 1);
+$oldnode->append_conf('postgresql.conf', "autovacuum = off\n");
+
+$oldnode->start;
+
+my $old_xid_size = $oldnode->safe_psql(
+	'postgres',
+	q{
+        SELECT typlen
+        FROM pg_type
+        WHERE typname = 'xid'
+          AND typnamespace = 'pg_catalog'::regnamespace
+    });
+
+plan skip_all => "source cluster is not xid32 (xid size $old_xid_size)"
+  unless $old_xid_size eq '4';
+
+# PG18 enables checksums by default; older sources may need enabling.
+if ($oldnode->safe_psql('postgres', 'SHOW data_checksums') eq 'off')
+{
+	$oldnode->stop;
+	$oldnode->command_ok(
+		[
+			$oldnode->installed_command('pg_checksums'),
+			'--enable',
+			'--no-sync',
+			'--pgdata' => $oldnode->data_dir
+		],
+		'data checksums enabled in old cluster');
+	$oldnode->start;
+}
+
+my $newnode = PostgreSQL::Test::Cluster->new('dxmax_new');
+$newnode->init;
+$newnode->append_conf('postgresql.conf', qq{
+autovacuum = off
+autovacuum_freeze_max_age = 1000000000000
+autovacuum_multixact_freeze_max_age = 1000000000000
+});
+$newnode->start;
+
+my $new_xid_size = $newnode->safe_psql(
+	'postgres',
+	q{
+        SELECT typlen
+        FROM pg_type
+        WHERE typname = 'xid'
+          AND typnamespace = 'pg_catalog'::regnamespace
+    });
+
+$newnode->stop;
+
+plan skip_all => "target cluster is not xid64 (xid size $new_xid_size)"
+  unless $new_xid_size eq '8';
+
+# Reproduce the source table from the report.  Variable-width rows pack pages
+# almost exactly, so a good fraction of them end up with less than 16 bytes of
+# free space and are converted to the double xmax layout.
+$oldnode->safe_psql(
+	'postgres',
+	q{
+        CREATE TABLE t (
+            id uuid PRIMARY KEY,
+            code varchar(25),
+            value numeric(16,8),
+            min_amount numeric(17,2),
+            max_amount numeric(17,2),
+            start_date date,
+            end_date date,
+            effective_date timestamptz,
+            is_actual boolean,
+            entity_version int DEFAULT 1,
+            id_in_2230 uuid,
+            update_time timestamp
+        );
+
+        INSERT INTO t
+        SELECT md5('id' || g)::uuid,
+               left(md5(g::text), 1 + (g * 7) % 25),
+               round((g % 1000) + (g % 97) / 97.0, g % 8),
+               CASE WHEN g % 3 = 0 THEN NULL ELSE 100 END,
+               CASE WHEN g % 5 = 0 THEN NULL ELSE 999999.99 END,
+               date '2025-11-25', date '2026-05-24',
+               timestamptz '2025-11-25 04:56:16+03', true, 1,
+               CASE WHEN g % 2 = 0 THEN md5('ext' || g)::uuid END,
+               CASE WHEN g % 4 = 0 THEN NULL ELSE timestamp '2025-11-25 01:56:16' END
+        FROM generate_series(1, 50000) g;
+
+        VACUUM FREEZE t;
+    });
+
+is(
+	$oldnode->safe_psql('postgres', 'SELECT count(*) FROM t'),
+	'50000',
+	'source table populated');
+
+$oldnode->stop;
+
+my $oldbindir = $oldnode->config_data('--bindir');
+my $newbindir = $newnode->config_data('--bindir');
+
+command_ok(
+	[
+		$newnode->installed_command('pg_upgrade'),
+		'--no-sync',
+		'--old-datadir' => $oldnode->data_dir,
+		'--new-datadir' => $newnode->data_dir,
+		'--old-bindir' => $oldbindir,
+		'--new-bindir' => $newbindir,
+		'--socketdir' => $newnode->host,
+		'--old-port' => $oldnode->port,
+		'--new-port' => $newnode->port,
+		$mode,
+	],
+	'upgrade xid32 cluster with nearly-full heap pages');
+
+$newnode->start;
+
+# The reproducer from the report: update a few rows that live on the heap pages
+# the converter places in the double xmax layout, then VACUUM.
+#
+# Only a part of each such page is superseded on purpose.  Updating every row
+# of the table hides the bug, because the whole page then becomes dead and
+# pruning can throw the line pointers away without having to classify each
+# tuple.  Taking the first tuple of each early page keeps those pages partially
+# dead and does not depend on one particular page number.
+$newnode->safe_psql(
+	'postgres',
+	q{
+        UPDATE t SET entity_version = entity_version + 1
+            WHERE (ctid::text::point)[0]::int BETWEEN 2 AND 200
+              AND (ctid::text::point)[1]::int = 1;
+    });
+
+# Verify that this run exercises genuine double-xmax pages, without a heap
+# SELECT that could set commit hints and hide the original VACUUM defect.
+$newnode->safe_psql('postgres', 'CHECKPOINT');
+my $path = $newnode->safe_psql('postgres',
+	q{SELECT pg_relation_filepath('t')});
+my $blcksz = $newnode->safe_psql('postgres', 'SHOW block_size');
+open(my $fh, '<:raw', $newnode->data_dir . '/' . $path) or die "open $path: $!";
+my $double_pages = 0;
+while (read($fh, my $page, $blcksz) == $blcksz)
+{
+	my ($special, $size_version) = unpack('SS', substr($page, 16, 4));
+	$double_pages++ if $special == $blcksz && ($size_version & 0xff) == 5;
+}
+close($fh);
+ok($double_pages > 0, 'updated table contains converted double-xmax pages');
+
+$newnode->safe_psql('postgres', 'VACUUM t');
+
+is(
+	$newnode->safe_psql('postgres', 'SELECT count(*) FROM t'),
+	'50000',
+	'VACUUM removed the superseded row versions');
+
+# Principal regression assertion: without the bug this is 0.  The buggy code
+# reports one duplicate per row that lived on a converted double xmax page.
+is(
+	$newnode->safe_psql(
+		'postgres',
+		q{
+        SELECT count(*) FROM (
+            SELECT id FROM t GROUP BY id HAVING count(*) > 1
+        ) d
+    }),
+	'0',
+	'no duplicate PRIMARY KEY values after UPDATE + VACUUM');
+
+$newnode->stop;
+
+done_testing();
diff --git a/src/bin/pg_upgrade/t/012_xid32_to_xid64_hot.pl b/src/bin/pg_upgrade/t/012_xid32_to_xid64_hot.pl
new file mode 100644
index 00000000000..2ae32924dc4
--- /dev/null
+++ b/src/bin/pg_upgrade/t/012_xid32_to_xid64_hot.pl
@@ -0,0 +1,156 @@
+# Copyright (c) 2026, Tantor Labs
+# Legacy conversion must preserve index roots while pruning source HOT chains.
+use strict;
+use warnings FATAL => 'all';
+use PostgreSQL::Test::Cluster;
+use PostgreSQL::Test::Utils;
+use Test::More;
+
+plan skip_all => 'oldinstall is required for legacy HOT conversion test'
+  unless defined $ENV{oldinstall};
+my $old = PostgreSQL::Test::Cluster->new('hot_old',
+	install_path => $ENV{oldinstall});
+$old->init(force_initdb => 1, xid32 => 1);
+$old->append_conf('postgresql.conf', 'autovacuum = off');
+$old->start;
+plan skip_all => 'source must use xid32'
+  unless $old->safe_psql('postgres',
+	q{SELECT typlen FROM pg_type WHERE oid = 'xid'::regtype}) == 4;
+if ($old->safe_psql('postgres', 'SHOW data_checksums') eq 'on')
+{
+	$old->stop;
+	$old->command_ok([$old->installed_command('pg_checksums'), '--disable',
+		'--no-sync', '--pgdata' => $old->data_dir], 'disable source checksums');
+	$old->start;
+}
+my @cases = (
+	['hot_live', 'c'], ['hot_redirect', 'd'], ['hot_deleted', ''],
+	['hot_abort_update', 'a'], ['hot_abort_insert', '']);
+my %paths;
+for my $case (@cases)
+{
+	my ($table, $value) = @$case;
+	$old->safe_psql('postgres', qq{
+		CREATE TABLE $table(id int PRIMARY KEY, payload text);
+		ALTER TABLE $table ALTER COLUMN payload SET STORAGE PLAIN;
+	});
+	$old->safe_psql('postgres', "INSERT INTO $table VALUES (1, 'a')")
+	  unless $table eq 'hot_abort_insert';
+	if ($table eq 'hot_redirect')
+	{
+		$old->safe_psql('postgres', "UPDATE $table SET payload = 'b' WHERE id = 1");
+		$old->safe_psql('postgres', "VACUUM $table");
+	}
+	# Retain old versions while the source page is filled. No heap SELECT may
+	# run after this snapshot ends: on-access pruning would hide the defect.
+	my $hold = $old->background_psql('postgres');
+	$hold->query_safe("BEGIN ISOLATION LEVEL REPEATABLE READ; SELECT count(*) FROM $table");
+	if ($table eq 'hot_abort_insert')
+	{
+		$old->safe_psql('postgres', qq{
+			BEGIN; INSERT INTO $table VALUES (1, 'a');
+			UPDATE $table SET payload = 'b' WHERE id = 1;
+			UPDATE $table SET payload = 'c' WHERE id = 1; ROLLBACK;
+		});
+	}
+	elsif ($table eq 'hot_abort_update')
+	{
+		$old->safe_psql('postgres', qq{
+			BEGIN; UPDATE $table SET payload = 'b' WHERE id = 1;
+			UPDATE $table SET payload = 'c' WHERE id = 1; ROLLBACK;
+		});
+	}
+	else
+	{
+		my ($first, $second) = $table eq 'hot_redirect' ? ('c', 'd') : ('b', 'c');
+		$old->safe_psql('postgres', "UPDATE $table SET payload = '$first' WHERE id = 1");
+		$old->safe_psql('postgres', "UPDATE $table SET payload = '$second' WHERE id = 1");
+		$old->safe_psql('postgres', "DELETE FROM $table WHERE id = 1")
+		  if $table eq 'hot_deleted';
+	}
+	# PLAIN text retains its four-byte varlena header, including for 'a'.
+	my $filler = $table eq 'hot_redirect' ? 7984 : 8000;
+	my $slot = $table eq 'hot_redirect' ? 5 : 4;
+	$old->safe_psql('postgres', "INSERT INTO $table VALUES (2, repeat('z', $filler))");
+	is($old->safe_psql('postgres', "SELECT ctid FROM $table WHERE id = 2"),
+		"(0,$slot)", "$table filler shares the original HOT page");
+	$paths{$table} = $old->safe_psql('postgres',
+		"SELECT pg_relation_filepath('$table')");
+	$hold->quit;
+}
+$old->stop;
+for my $case (@cases)
+{
+	my $table = $case->[0];
+	open(my $fh, '<:raw', $old->data_dir . '/' . $paths{$table}) or die $!;
+	read($fh, my $header, 24) == 24 or die 'short page header';
+	close($fh);
+	my ($lower, $upper) = unpack('SS', substr($header, 12, 4));
+	cmp_ok($upper - $lower, '<', 16, "$table must enter conversion's dense-page path");
+}
+
+my $new = PostgreSQL::Test::Cluster->new('hot_primary');
+$new->init(allows_streaming => 1, extra => ['--no-data-checksums']);
+$new->append_conf('postgresql.conf', qq{
+autovacuum = off
+autovacuum_freeze_max_age = 1000000000000
+autovacuum_multixact_freeze_max_age = 1000000000000
+io_method = worker
+full_page_writes = off
+wal_log_hints = off
+wal_consistency_checking = all
+});
+command_ok([
+	$new->installed_command('pg_upgrade'), '--no-sync', '--copy',
+	'--old-datadir' => $old->data_dir, '--new-datadir' => $new->data_dir,
+	'--old-bindir' => $old->config_data('--bindir'),
+	'--new-bindir' => $new->config_data('--bindir'),
+	'--socketdir' => $new->host, '--old-port' => $old->port,
+	'--new-port' => $new->port], 'upgrade source HOT chains');
+$new->backup_fs_cold('before_conversion');
+my $standby = PostgreSQL::Test::Cluster->new('hot_standby');
+$standby->init_from_backup($new, 'before_conversion', has_streaming => 1);
+$new->start;
+$standby->start;
+for my $case (@cases)
+{
+	my ($table, $value) = @$case;
+	like($new->safe_psql('postgres', qq{
+		SET enable_seqscan = off;
+		EXPLAIN SELECT payload FROM $table WHERE id = 1;
+	}), qr/Index Scan/, "$table actually uses the preserved primary-key index");
+	is($new->safe_psql('postgres', qq{
+		SET enable_seqscan = off;
+		SELECT payload FROM $table WHERE id = 1;
+	}), $value, "$table index reaches the surviving row after conversion");
+	is($new->safe_psql('postgres', qq{
+		SET enable_indexscan = off; SET enable_bitmapscan = off;
+		SELECT payload FROM $table WHERE id = 1;
+	}), $value, "$table sequential scan agrees");
+	# Exercise incremental WAL after conversion already logged the rewritten root.
+	$new->safe_psql('postgres', "UPDATE $table SET payload = repeat('q', length(payload)) WHERE id = 2");
+	$new->safe_psql('postgres', "UPDATE $table SET payload = 'new' WHERE id = 1")
+	  if length $value;
+}
+$new->wait_for_catchup($standby);
+for my $case (@cases)
+{
+	my ($table, $value) = @$case;
+	is($standby->safe_psql('postgres', qq{
+		SET enable_seqscan = off;
+		SELECT payload FROM $table WHERE id = 1;
+	}), length($value) ? 'new' : '', "$table index and HOT updates survive standby replay");
+}
+$standby->stop;
+$new->stop('immediate');
+$new->start;
+for my $case (@cases)
+{
+	my ($table, $value) = @$case;
+	is($new->safe_psql('postgres', qq{
+		SET enable_seqscan = off;
+		SELECT payload FROM $table WHERE id = 1;
+	}), length($value) ? 'new' : '', "$table index survives primary crash recovery");
+}
+$new->stop;
+done_testing();
