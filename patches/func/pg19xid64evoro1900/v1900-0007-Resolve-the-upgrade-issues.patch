+/*
+ * Track a format conversion that must be covered by a full image in WAL.
+ * AIO completion publishes this marker together with BM_CONVERSION_PENDING.
+ * Normal backend conversion logs its image immediately and clears both bits.
+ * When conversion cannot insert WAL, this marker remains until WAL covers the
+ * format change.  A completed overwrite can discharge both obligations when
+ * its buffer is registered for WAL.  It does not mean conversion is pending.
+ */
+void
+MarkBufferConversionNeedsWAL(Buffer buffer, bool needs_wal)
+{
+	BufferDesc *bufHdr;
+	uint64		buf_state;
+
+	Assert(BufferIsValid(buffer) && !BufferIsLocal(buffer));
+	bufHdr = GetBufferDescriptor(buffer - 1);
+	buf_state = pg_atomic_read_u64(&bufHdr->state);
+	Assert(!needs_wal ||
+		   ((buf_state & BM_IO_IN_PROGRESS) && !(buf_state & BM_VALID)) ||
+		   BufferLockHeldByMe(bufHdr));
+
+	if (((buf_state & BM_CONVERSION_NEEDS_WAL) != 0) == needs_wal &&
+		(needs_wal || !(buf_state & BM_CONVERSION_PENDING)))
+		return;
+	/* A WAL-logged overwrite can discharge both obligations together. */
+	Assert(needs_wal || !(buf_state & BM_CONVERSION_PENDING) ||
+		   (BufferLockHeldByMe(bufHdr) &&
+			(PageIsNew(BufferGetPage(buffer)) ||
+			 PageGetPageLayoutVersion(BufferGetPage(buffer)) == PG_PAGE_LAYOUT_VERSION)));
+
+	buf_state = LockBufHdr(bufHdr);
+	UnlockBufHdrExt(bufHdr, buf_state,
+					needs_wal ? BM_CONVERSION_NEEDS_WAL : 0,
+					needs_wal ? 0 :
+					(BM_CONVERSION_NEEDS_WAL | BM_CONVERSION_PENDING), 0);
+}
+
+bool
+BufferConversionNeedsWAL(Buffer buffer)
+{
+	BufferDesc *bufHdr;
+
+	Assert(BufferIsValid(buffer) && !BufferIsLocal(buffer));
+	Assert(BufferIsPinned(buffer));
+	bufHdr = GetBufferDescriptor(buffer - 1);
+	return (pg_atomic_read_u64(&bufHdr->state) & BM_CONVERSION_NEEDS_WAL) != 0;
+}
