+/* Copy xid64 SLRUs, normalizing the supported legacy 12-digit names. */
+static void
+copy_slru_subdir(const char *subdir)
+{
+	char	   *path;
+	DIR		   *dir;
+	struct dirent *entry;
+
+	copy_subdir_files(subdir, subdir);
+	if (GET_MAJOR_VERSION(old_cluster.major_version) >= 1800)
+		return;
+
+	path = psprintf("%s/%s", new_cluster.pgdata, subdir);
+	dir = opendir(path);
+	if (dir == NULL)
+		pg_fatal("could not open directory \"%s\": %m", path);
+	while ((entry = readdir(dir)) != NULL)
+	{
+		char	   *oldpath,
+			   *newpath;
+		uint64		segment;
+
+		if (strlen(entry->d_name) != 12 ||
+			strspn(entry->d_name, "0123456789ABCDEFabcdef") != 12)
+			continue;
+		segment = strtou64(entry->d_name, NULL, 16);
+		oldpath = psprintf("%s/%s", path, entry->d_name);
+		newpath = psprintf("%s/%015" PRIX64, path, segment);
+		if (rename(oldpath, newpath) != 0)
+			pg_fatal("could not rename file \"%s\" to \"%s\": %m", oldpath, newpath);
+		pg_free(oldpath);
+		pg_free(newpath);
+	}
+	closedir(dir);
+	pg_free(path);
+}
