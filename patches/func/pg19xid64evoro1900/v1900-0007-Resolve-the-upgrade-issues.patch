+/*
+ * Lazy page conversion from 32-bit to 64-bit XID at first read.
+ */
+void
+convert_page(RelationExtraData *rel_extra, RelFileLocator *relfilelocator, ForkNumber forknum,
+			 Page page, Buffer buf, BlockNumber blkno)
+{
+	/*
+	 * The reading backend converts a private copy before exposing the page.
+	 * The caller publishes it and logs a conversion image when WAL is allowed.
+	 */
+	if (rel_extra->relkind == RELKIND_RELATION ||
+		rel_extra->relkind == RELKIND_MATVIEW ||
+		rel_extra->relkind == RELKIND_TOASTVALUE)
+		validate_legacy_heap_page(page);
+
+	convert_page_internal(rel_extra, relfilelocator, forknum, page, buf, blkno);
+	MarkBufferConversionNeedsWAL(buf, true);
+}
+
+/* Expand a source 32-bit MultiXactId using the relation's source horizon. */
+static inline MultiXactId
+full_source_multixact(MultiXactId mxid, MultiXactId source_multi_base)
+{
+	if (mxid < source_multi_base)
+		mxid += ((MultiXactId) 1 << 32) - FirstMultiXactId;
+
+	Assert(mxid >= source_multi_base);
+	return mxid;
+}
+
+/*
+ * Convert xmin and xmax in a tuple.
+ * This also considers special cases: "double xmax" page format and multixact
+ * in xmax.
+ */
+static void
+convert_heap_tuple_xids(HeapTupleHeader tuple, TransactionId xid_base,
+						MultiXactId source_multi_base,
+						MultiXactId page_multi_base, bool double_xmax)
+{
+	/* Convert xmin */
+	if (double_xmax)
+	{
+		/* Prepare tuple for "double xmax" page format */
+		tuple->t_infomask |= HEAP_XMIN_FROZEN;
+		tuple->t_choice.t_heap.t_xmin = 0;
+	}
+	else
+	{
+		TransactionId xmin = tuple->t_choice.t_heap.t_xmin;
+
+		if (TransactionIdIsNormal(xmin))
+		{
+			if (HeapTupleHeaderXminFrozen(tuple))
+				tuple->t_choice.t_heap.t_xmin = FrozenTransactionId;
+			else if (HeapTupleHeaderXminInvalid(tuple))
+				tuple->t_choice.t_heap.t_xmin = InvalidTransactionId;
+			else
+			{
+				Assert(xmin >= xid_base + FirstNormalTransactionId);
+				/* Subtract xid_base from normal xmin */
+				tuple->t_choice.t_heap.t_xmin = xmin - xid_base;
+			}
+		}
+	}
+
+	/* If tuple has multixact flag, handle mxid wraparound */
+	if ((tuple->t_infomask & HEAP_XMAX_IS_MULTI) &&
+		!(tuple->t_infomask & HEAP_XMAX_INVALID))
+	{
+		MultiXactId mxid = full_source_multixact(
+			tuple->t_choice.t_heap.t_xmax, source_multi_base);
+
+		if (double_xmax)
+		{
+			/* Save converted mxid into "double xmax" format */
+			HeapTupleHeaderSetDoubleXmax(tuple, mxid);
+		}
+		else
+		{
+			/*
+			 * The short field is relative to the destination page's MultiXact
+			 * base.  As with short XIDs, relative values begin at 3; values 1
+			 * and 2 are read as absolute special values.
+			 */
+			Assert(mxid >= page_multi_base);
+			Assert(mxid - page_multi_base <= PG_UINT32_MAX);
+			Assert(page_multi_base == InvalidMultiXactId ||
+				   mxid - page_multi_base >= FirstNormalTransactionId);
+			tuple->t_choice.t_heap.t_xmax =
+				(uint32) (mxid - page_multi_base);
+		}
+	}
+	/* Convert xmax */
+	else if (!(tuple->t_infomask & HEAP_XMAX_INVALID))
+	{
+		TransactionId xmax = tuple->t_choice.t_heap.t_xmax;
+
+		if (double_xmax)
+		{
+			/* Save converted xmax into "double xmax" format */
+			HeapTupleHeaderSetDoubleXmax(tuple, xmax);
+		}
+		else if (TransactionIdIsNormal(xmax))
+		{
+			/* Subtract xid_base from normal xmax */
+			Assert(xmax >= xid_base + FirstNormalTransactionId);
+			tuple->t_choice.t_heap.t_xmax = xmax - xid_base;
+		}
+	}
+	else
+	{
+		if (double_xmax)
+			HeapTupleHeaderSetDoubleXmax(tuple, InvalidTransactionId);
+		else
+			tuple->t_choice.t_heap.t_xmax = InvalidTransactionId;
+	}
+}
+
+/*
+ * Correct page xmin/xmax based on tuple xmin/xmax values.
+ */
+static void
+compute_xid_min_max(HeapTuple tuple, MultiXactId multi_base,
+					TransactionId *xid_min, TransactionId *xid_max,
+					MultiXactId *multi_min, MultiXactId *multi_max)
+{
+	/* xmin */
+	if (!HeapTupleHeaderXminInvalid(tuple->t_data) &&
+		!HeapTupleHeaderXminFrozen(tuple->t_data))
+	{
+		TransactionId xid = HeapTupleGetRawXmin(tuple);
+
+		if (TransactionIdIsNormal(xid))
+		{
+			*xid_max = Max(*xid_max, xid);
+			*xid_min = Min(*xid_min, xid);
+		}
+	}
+
+	/* xmax */
+	if (!(tuple->t_data->t_infomask & HEAP_XMAX_INVALID))
+	{
+		TransactionId xid;
+
+		if (tuple->t_data->t_infomask & HEAP_XMAX_IS_MULTI)
+		{
+			MultiXactId mxid = HeapTupleGetRawXmax(tuple);
+
+			Assert(MultiXactIdIsValid(mxid));
+
+			mxid = full_source_multixact(mxid, multi_base);
+
+			*multi_max = Max(*multi_max, mxid);
+			*multi_min = Min(*multi_min, mxid);
+
+			/*
+			 * Also take into account hidden update xid, which can be
+			 * extracted by the vacuum.
+			 */
+			if (tuple->t_data->t_infomask & HEAP_XMAX_LOCK_ONLY)
+				xid = InvalidTransactionId;
+			else
+				xid = HeapTupleGetUpdateXid(tuple);
+		}
+		else
+		{
+			xid = HeapTupleGetRawXmax(tuple);
+		}
+
+		if (TransactionIdIsNormal(xid))
+		{
+			*xid_max = Max(*xid_max, xid);
+			*xid_min = Min(*xid_min, xid);
+		}
+	}
+}
+
+/*
+ * Returns true if both:
+ *  - xid_max: an uppper boundary of xmin's and xmax'es of all tuples on a page
+ *  - xid_min: a lower boundary of xmin's and xmax'es of all tuples on a page
+ *    can be expressed by 32-bit number relative to page's xid_base/multi_base
+ *    or invalid.
+ *
+ * True value effectively means that these tuples can be directly put on one
+ * page in 64-xid format.
+ */
+static inline bool
+xids_fit_page(TransactionId xid_min, TransactionId xid_max,
+			  MultiXactId multi_min, MultiXactId multi_max)
+{
+	bool xid_max_fits = false;
+	bool multi_max_fits = false;
+
+	if (xid_max == InvalidTransactionId)
+		xid_max_fits = true;
+
+	if (xid_max - xid_min <= MaxShortTransactionId - FirstNormalTransactionId)
+		xid_max_fits = true;
+
+	if (multi_max == InvalidMultiXactId)
+		multi_max_fits = true;
+
+	if (multi_max - multi_min <= MaxShortTransactionId - FirstNormalTransactionId)
+		multi_max_fits = true;
+
+	return xid_max_fits && multi_max_fits;
+}
+
+/*
+ * Set "base" for page in 64-bit XID format.
+ *
+ * This should not be called for double xmax pages. They do not have place for
+ * page special.
+ */
+static inline void
+heap_page_set_base(Page page,
+				   TransactionId xid_min, TransactionId xid_max,
+				   MultiXactId multi_min, MultiXactId multi_max,
+				   TransactionId *xid_base, MultiXactId *multi_base,
+				   bool is_toast)
+{
+	PageHeader			hdr = (PageHeader) page;
+
+	if (xid_max != InvalidTransactionId)
+		*xid_base = xid_min - FirstNormalTransactionId;
+	else
+		*xid_base = InvalidTransactionId;
+
+	if (multi_max != InvalidMultiXactId)
+		*multi_base = multi_min >= FirstNormalTransactionId ?
+			multi_min - FirstNormalTransactionId : InvalidMultiXactId;
+	else
+		*multi_base = InvalidMultiXactId;
+
+	if (is_toast)
+	{
+		ToastPageSpecial		special;
+
+		hdr->pd_special = ToastPageSpecialOffset;
+		special = ToastPageGetSpecial(page);
+		special->pd_xid_base = *xid_base;
+	}
+	else
+	{
+		HeapPageSpecial		special;
+
+		hdr->pd_special = HeapPageSpecialOffset;
+		special = HeapPageGetSpecial(page);
+		special->pd_xid_base = *xid_base;
+		special->pd_multi_base = *multi_base;
+	}
+}
+
+/*
+ * Prune source HOT chains before xmin identities are frozen for double xmax.
+ * All source transactions precede the target's first normal counter.  This
+ * runs on the reading backend's private copy, before any page is exposed, so
+ * eligible tuple storage can be reclaimed and the conversion image will log
+ * the resulting redirects/dead/unused items together with the new format.
+ */
+static void
+prune_legacy_heap_page(Page page, MultiXactId source_multi_base,
+					   BlockNumber blkno)
+{
+	HeapTupleData tuples[MaxHeapTuplesPerPage + 1];
+	bool		dead[MaxHeapTuplesPerPage + 1] = {false};
+	bool		processed[MaxHeapTuplesPerPage + 1] = {false};
+	OffsetNumber maxoff = PageGetMaxOffsetNumber(page);
+
+	for (OffsetNumber off = FirstOffsetNumber; off <= maxoff; ++off)
+	{
+		ItemId		item = PageGetItemId(page, off);
+		HeapTuple	tuple = &tuples[off];
+		HTSV_Result status;
+
+		if (!ItemIdIsNormal(item))
+			continue;
+		tuple->t_data = (HeapTupleHeader) PageGetItem(page, item);
+		tuple->t_len = ItemIdGetLength(item);
+		tuple->t_tableOid = 1;
+		ItemPointerSet(&tuple->t_self, blkno, off);
+		HeapTupleCopyHeaderXids(tuple);
+		if ((tuple->t_data->t_infomask & HEAP_XMAX_IS_MULTI) &&
+			!(tuple->t_data->t_infomask & HEAP_XMAX_INVALID))
+			tuple->t_xmax = full_source_multixact(tuple->t_xmax,
+												 source_multi_base);
+		status = HeapTupleSatisfiesVacuum(tuple, UINT64CONST(1) << 32,
+									 InvalidBuffer);
+		if (status != HEAPTUPLE_LIVE && status != HEAPTUPLE_DEAD)
+			ereport(ERROR,
+					(errcode(ERRCODE_DATA_CORRUPTED),
+					 errmsg("unexpected in-progress source tuple during legacy conversion")));
+		dead[off] = status == HEAPTUPLE_DEAD;
+
+		/*
+		 * Visibility's no-buffer mode does not write hints.  On this private
+		 * copy, mark aborted insertions explicitly so their HOT flag cannot
+		 * make an unlinked aborted heap-only tuple look like a live chain.
+		 */
+		if (dead[off] && !HeapTupleHeaderXminCommitted(tuple->t_data) &&
+			!TransactionIdDidCommit(HeapTupleGetRawXmin(tuple)))
+			tuple->t_data->t_infomask |= HEAP_XMIN_INVALID;
+	}
+
+	for (OffsetNumber root = FirstOffsetNumber; root <= maxoff; ++root)
+	{
+		ItemId		rootitem = PageGetItemId(page, root);
+		OffsetNumber off;
+		OffsetNumber chain[MaxHeapTuplesPerPage];
+		int			ndead = 0;
+		TransactionId prior_xmax = InvalidTransactionId;
+
+		if (ItemIdIsRedirected(rootitem))
+			off = ItemIdGetRedirect(rootitem);
+		else if (ItemIdIsNormal(rootitem) &&
+				 !HeapTupleIsHeapOnly(&tuples[root]))
+			off = root;
+		else
+			continue;
+
+		for (;;)
+		{
+			ItemId		item;
+			HeapTuple	tuple;
+
+			if (off < FirstOffsetNumber || off > maxoff || processed[off])
+				ereport(ERROR,
+						(errcode(ERRCODE_DATA_CORRUPTED),
+						 errmsg("invalid legacy HOT chain at offset %u", root)));
+			item = PageGetItemId(page, off);
+			if (!ItemIdIsNormal(item))
+				ereport(ERROR,
+						(errcode(ERRCODE_DATA_CORRUPTED),
+						 errmsg("invalid legacy HOT successor at offset %u", off)));
+			tuple = &tuples[off];
+			if ((off != root && !HeapTupleIsHeapOnly(tuple)) ||
+				(TransactionIdIsValid(prior_xmax) &&
+				 !TransactionIdEquals(prior_xmax, HeapTupleGetXmin(tuple))))
+				ereport(ERROR,
+						(errcode(ERRCODE_DATA_CORRUPTED),
+						 errmsg("broken legacy HOT chain at offset %u", off)));
+			if (!dead[off])
+				break;
+
+			processed[off] = true;
+			chain[ndead++] = off;
+			if (!HeapTupleIsHotUpdated(tuple))
+			{
+				off = InvalidOffsetNumber;
+				break;
+			}
+			if (ItemPointerGetBlockNumber(&tuple->t_data->t_ctid) != blkno)
+				ereport(ERROR,
+						(errcode(ERRCODE_DATA_CORRUPTED),
+						 errmsg("legacy HOT chain leaves its source page")));
+			prior_xmax = HeapTupleGetUpdateXidAny(tuple);
+			off = ItemPointerGetOffsetNumber(&tuple->t_data->t_ctid);
+		}
+
+		if (ndead == 0)
+			continue;
+		for (int i = 0; i < ndead; ++i)
+		{
+			if (chain[i] != root)
+			{
+				ItemIdSetUnused(PageGetItemId(page, chain[i]));
+				PageSetHasFreeLinePointers(page);
+			}
+		}
+		if (OffsetNumberIsValid(off))
+			ItemIdSetRedirect(rootitem, off);
+		else
+			ItemIdSetDead(rootitem);
+	}
+
+	/* Aborted heap-only versions need not be linked from a surviving chain. */
+	for (OffsetNumber off = FirstOffsetNumber; off <= maxoff; ++off)
+	{
+		ItemId		item = PageGetItemId(page, off);
+
+		if (!ItemIdIsNormal(item) || !dead[off])
+			continue;
+		if (!HeapTupleIsHeapOnly(&tuples[off]) ||
+			HeapTupleIsHotUpdated(&tuples[off]))
+			ereport(ERROR,
+					(errcode(ERRCODE_DATA_CORRUPTED),
+					 errmsg("unlinked dead legacy HOT tuple at offset %u", off)));
+		ItemIdSetUnused(item);
+		PageSetHasFreeLinePointers(page);
+	}
+}
+
+/*
+ * repack_heap_tuples
+ *		Convert heap page format reusing space of dead tuples
+ */
+static void
+repack_heap_tuples(RelationExtraData *rel_extra, RelFileLocator *relfilelocator,
+				   ForkNumber forknumber, Page page, Buffer buf, BlockNumber blkno,
+				   bool try_double_xmax)
+{
+	ItemIdCompactData	items[MaxHeapTuplesPerPage];
+	ItemIdCompact		itemPtr = items;
+	int					nitems = 0,
+						maxoff = PageGetMaxOffsetNumber(page),
+						idx,
+						occupied_space = 0;
+	Offset				upper;
+	bool				double_xmax,
+						special_fits,
+						toast;
+	PageHeader			hdr = (PageHeader) page,
+						new_hdr;
+	PGAlignedBlock		zerobuf = {0};
+	Page				new_page;
+	MultiXactId			source_multi_base = rel_extra->relminmxid,
+						page_multi_base = InvalidMultiXactId,
+						multi_min = MaxMultiXactId,
+						multi_max = InvalidMultiXactId;
+	TransactionId		xid_base = rel_extra->relfrozenxid,
+						xid_min = MaxTransactionId,
+						xid_max = InvalidTransactionId;
+
+	toast = rel_extra->relkind == RELKIND_TOASTVALUE;
+
+	if (try_double_xmax)
+		prune_legacy_heap_page(page, source_multi_base, blkno);
+
+	if (TransactionIdIsNormal(hdr->pd_prune_xid))
+		xid_min = xid_max = hdr->pd_prune_xid;
+
+	for (idx = 0; idx < maxoff; idx++)
+	{
+		HeapTupleData		tuple;
+		ItemId				lp;
+
+		lp = PageGetItemId(page, idx + 1);
+
+		/* Skip redirects and items without storage */
+		if (!ItemIdHasStorage(lp))
+			continue;
+
+		/* Build in-memory tuple representation */
+		tuple.t_tableOid = 1;	/* doesn't matter in this case */
+		tuple.t_data = (HeapTupleHeader) PageGetItem(page, lp);
+		HeapTupleCopyHeaderXids(&tuple);
+		/* A wrapped source MXID must be valid before visibility checks. */
+		if ((tuple.t_data->t_infomask & HEAP_XMAX_IS_MULTI) &&
+			!(tuple.t_data->t_infomask & HEAP_XMAX_INVALID))
+			tuple.t_xmax = full_source_multixact(tuple.t_xmax,
+												 source_multi_base);
+		tuple.t_len = ItemIdGetLength(lp);
+		ItemPointerSet(&(tuple.t_self), blkno, idx + 1);
+
+
+		if (ItemIdIsNormal(lp) && ItemIdHasStorage(lp))
+		{
+			itemPtr->offsetindex = idx;
+			itemPtr->itemoff = ItemIdGetOffset(lp);
+			if (unlikely(itemPtr->itemoff < hdr->pd_upper ||
+						 itemPtr->itemoff >= hdr->pd_special))
+			{
+				ereport(ERROR,
+						(errcode(ERRCODE_DATA_CORRUPTED),
+						 errmsg("corrupted item pointer: %u of relation \"%s\"",
+								itemPtr->itemoff,
+								relpathperm(*relfilelocator, forknumber).str)));
+			}
+
+			itemPtr->alignedlen = MAXALIGN(ItemIdGetLength(lp));
+			occupied_space += itemPtr->alignedlen;
+			nitems++;
+			itemPtr++;
+			if (try_double_xmax)
+			{
+				HeapTupleSetXmin(&tuple, FrozenTransactionId);
+				HeapTupleHeaderStoreXminFrozen(tuple.t_data);
+			}
+
+			compute_xid_min_max(&tuple, source_multi_base,
+								&xid_min, &xid_max,
+								&multi_min, &multi_max);
+		}
+	}
+
+	new_page = (Page) zerobuf.data;
+	MemSet(new_page, 0, BLCKSZ);
+	/* Write new header */
+	new_hdr = (PageHeader) new_page;
+	*new_hdr = *hdr;
+	new_hdr->pd_lower = SizeOfPageHeaderData + maxoff * sizeof(ItemIdData);
+
+	if (toast)
+		special_fits = ToastPageSpecialOffset >=
+						new_hdr->pd_lower + occupied_space;
+	else
+		special_fits = HeapPageSpecialOffset >=
+						new_hdr->pd_lower + occupied_space;
+
+	double_xmax = !special_fits ||
+				  !xids_fit_page(xid_min, xid_max, multi_min, multi_max);
+
+	if (!double_xmax)
+	{
+		Assert(xid_max == InvalidTransactionId || xid_max >= xid_min);
+		Assert(multi_max == InvalidMultiXactId || multi_max >= multi_min);
+
+		heap_page_set_base(new_page,
+						   xid_min, xid_max,
+						   multi_min, multi_max,
+						   &xid_base, &page_multi_base,
+						   toast);
+
+		HeapPageSetPruneXid(new_page, new_hdr->pd_prune_xid);
+	}
+	else
+	{
+		/* No space for special area, switch to "double xmax" format */
+		elog(DEBUG2, "convert heap page %u of relation \"%s\" to double xmax format",
+			 blkno, relpathperm(*relfilelocator, forknumber).str);
+
+		if (try_double_xmax)
+		{
+			xid_base = InvalidTransactionId;
+			page_multi_base = InvalidMultiXactId;
+		}
+		else
+		{
+			repack_heap_tuples(rel_extra, relfilelocator, forknumber, page, buf, blkno, true);
+			return;
+		}
+	}
+
+	/* Copy ItemIds with an offset */
+	memcpy((char *) new_page + SizeOfPageHeaderData,
+		   (char *) page + SizeOfPageHeaderData,
+		   hdr->pd_lower - SizeOfPageHeaderData);
+
+	/* Move live tuples */
+	upper = new_hdr->pd_special;
+	for (idx = 0; idx < nitems; idx++)
+	{
+		HeapTupleHeader		tuple;
+		ItemId				lp;
+
+		itemPtr = &items[idx];
+		lp = PageGetItemId(new_page, itemPtr->offsetindex + 1);
+		upper -= itemPtr->alignedlen;
+		occupied_space -= itemPtr->alignedlen;
+
+		memcpy((char *) new_page + upper,
+			   (char *) page + itemPtr->itemoff,
+			   itemPtr->alignedlen);
+
+		tuple = (HeapTupleHeader) (((char *) new_page) + upper);
+
+		convert_heap_tuple_xids(tuple, xid_base, source_multi_base,
+								page_multi_base, double_xmax);
+
+		lp->lp_off = upper;
+	}
+
+	Assert(occupied_space == 0);
+
+	new_hdr->pd_upper = upper;
+	if (new_hdr->pd_lower > new_hdr->pd_upper)
+		elog(ERROR, "cannot convert block %u of relation \"%s\"",
+			 blkno, relpathperm(*relfilelocator, forknumber).str);
+
+	memcpy(page, new_page, BLCKSZ);
+}
