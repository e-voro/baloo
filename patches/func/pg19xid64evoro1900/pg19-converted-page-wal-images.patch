From b052fd6b675b7f8a2b7fe20582ae1963b481da51 Mon Sep 17 00:00:00 2001
From: Evgeny Voropaev <evorop@gmail.com>
Date: Wed, 21 Oct 2026 20:29:12 +0800
Subject: [PATCH] Preserve conversion WAL images through PG19 prune and replay
 paths

Adapt supplied fix 0015: conversion images override NO_IMAGE, NO_CHANGE references retain markers and WILL_INIT remains reconstructible. PG19 visibility changes use prune WAL with heap-LSN advancement. Test real user-XID rejection, safe row types, dense frozen/unfrozen AIO conversion and PG15.19 streaming replay with checksums, hints and full-page writes disabled.
---
 src/backend/access/heap/pruneheap.c           |  10 +-
 src/backend/access/transam/xloginsert.c       |  15 +-
 src/bin/pg_upgrade/Makefile                   |   2 +-
 src/bin/pg_upgrade/meson.build                |   1 +
 .../t/009_xid32_to_xid64_recovery.pl          | 184 ++++++++++++++++++
 src/test/perl/PostgreSQL/Test/Cluster.pm      |  36 ++--
 src/test/regress/regress.c                    |  25 +++
 7 files changed, 248 insertions(+), 25 deletions(-)
 create mode 100644 src/bin/pg_upgrade/t/009_xid32_to_xid64_recovery.pl

diff --git a/src/backend/access/heap/pruneheap.c b/src/backend/access/heap/pruneheap.c
index 010d61e1f60..54753c26180 100644
--- a/src/backend/access/heap/pruneheap.c
+++ b/src/backend/access/heap/pruneheap.c
@@ -2672,14 +2672,18 @@ log_heap_prune_and_freeze(Relation relation, Buffer buffer,
 	 * making to it is to set PD_ALL_VISIBLE and checksums/wal_log_hints are
 	 * disabled.
 	 *
-	 * However, if the page has never been WAL-logged (LSN is invalid), we
-	 * must force an FPI regardless.  This can happen when another backend
+	 * A converted page needs an FPI even with checksums and hints disabled:
+	 * redo has no relcache metadata with which to decode the old disk page.
+	 * We must also stamp its heap LSN when logging the conversion image.
+	 *
+	 * If the page has never been WAL-logged (LSN is invalid), we must force
+	 * an FPI regardless.  This can happen when another backend
 	 * extends the heap, initializes the page, and then fails before WAL-
 	 * logging it.  Since heap extension is not WAL-logged, recovery might try
 	 * to replay our record and find that the page isn't initialized, which
 	 * would cause a PANIC.
 	 */
-	if (!XLogRecPtrIsValid(PageGetLSN(heap_page)))
+	if (IsBufferConverted(buffer) || !XLogRecPtrIsValid(PageGetLSN(heap_page)))
 		regbuf_flags_heap |= REGBUF_FORCE_IMAGE;
 	else if (!do_prune && nfrozen == 0 && (!do_set_vm || !XLogHintBitIsNeeded()))
 	{
diff --git a/src/backend/access/transam/xloginsert.c b/src/backend/access/transam/xloginsert.c
index 075a761d951..95f72c687b9 100644
--- a/src/backend/access/transam/xloginsert.c
+++ b/src/backend/access/transam/xloginsert.c
@@ -283,8 +283,13 @@ XLogRegisterBuffer(uint8 block_id, Buffer buffer, uint8 flags)
 	regbuf->flags = flags;
 	if (IsBufferConverted(buffer))
 	{
-		regbuf->flags |= REGBUF_CONVERTED;
-		MarkBufferConverted(buffer, false);
+		/* WILL_INIT reconstructs the page without reading legacy contents. */
+		if ((flags & REGBUF_WILL_INIT) != REGBUF_WILL_INIT)
+			regbuf->flags |= REGBUF_CONVERTED;
+
+		/* Keep the marker on references that need not make the page durable. */
+		if (!(flags & REGBUF_NO_CHANGE))
+			MarkBufferConverted(buffer, false);
 	}
 	regbuf->rdata_tail = (XLogRecData *) &regbuf->rdata_head;
 	regbuf->rdata_len = 0;
@@ -680,13 +685,11 @@ XLogRecordAssemble(RmgrId rmid, uint8 info,
 		if (!regbuf->in_use)
 			continue;
 
-		/* Determine if this block needs to be backed up */
-		if (regbuf->flags & REGBUF_FORCE_IMAGE)
+		/* Conversion images are required even without torn-page protection. */
+		if (regbuf->flags & (REGBUF_FORCE_IMAGE | REGBUF_CONVERTED))
 			needs_backup = true;
 		else if (regbuf->flags & REGBUF_NO_IMAGE)
 			needs_backup = false;
-		else if (regbuf->flags & REGBUF_CONVERTED)
-			needs_backup = true;
 		else if (!doPageWrites)
 			needs_backup = false;
 		else
