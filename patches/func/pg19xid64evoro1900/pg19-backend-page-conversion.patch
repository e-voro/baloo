-	 * BM_CONVERTED flag, which means 'converted only in memory'. The page will
-	 * be logged with full-page-write record on first actual change later.
-	 *
-	 * TODO: Also it is suggested that VACUUM, having found the BM_CONVERTED
-	 * flag on the page, considering it dirty, logging the converted page with
-	 * FPW, which eventually results in updating the page on the disk.
+	 * The reading backend converts a private copy before exposing the page.
+	 * Keep it clean until a modifying backend logs a conversion image.
 	 */
+	if (rel_extra->relkind == RELKIND_RELATION ||
+		rel_extra->relkind == RELKIND_MATVIEW ||
+		rel_extra->relkind == RELKIND_TOASTVALUE)
+		validate_legacy_heap_page(page);
 
 	convert_page_internal(rel_extra, relfilelocator, forknum, page, buf, blkno);
 	MarkBufferConverted(buf, true);
@@ -411,7 +454,7 @@ repack_heap_tuples(RelationExtraData *rel_extra, RelFileLocator *relfilelocator,
