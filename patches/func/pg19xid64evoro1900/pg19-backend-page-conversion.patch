@@ -420,7 +463,7 @@ repack_heap_tuples(RelationExtraData *rel_extra, RelFileLocator *relfilelocator,
 		 * HeapTupleSatisfiesVacuum() for details
 		 *
 		 * InvalidBuffer preserves the predecoded source XIDs and suppresses
