 						 errmsg("corrupted item pointer: %u of relation \"%s\"",
@@ -545,10 +584,6 @@ repack_heap_tuples(RelationExtraData *rel_extra, RelFileLocator *relfilelocator,
 
 	new_hdr->pd_upper = upper;
