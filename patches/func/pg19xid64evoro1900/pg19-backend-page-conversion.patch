diff --git a/src/backend/storage/buffer/heap_convert.c b/src/backend/storage/buffer/heap_convert.c
index 39487cd43af..525846ab234 100644
--- a/src/backend/storage/buffer/heap_convert.c
+++ b/src/backend/storage/buffer/heap_convert.c
@@ -93,6 +93,54 @@ itemoffcompare(const void *item1, const void *item2)
 		   ((ItemIdCompactData *) item1)->itemoff;
 }
 
+/* Validate tuple storage before conversion can move or enlarge any data. */
+static void
+validate_legacy_heap_page(Page page)
+{
+	PageHeader header = (PageHeader) page;
+	ItemIdCompactData items[MaxHeapTuplesPerPage];
+	OffsetNumber maxoff = PageGetMaxOffsetNumber(page);
+	int nitems = 0;
+	int upper = header->pd_special;
+
+	if (maxoff > MaxHeapTuplesPerPage || header->pd_special != BLCKSZ)
+		ereport(ERROR,
+				(errcode(ERRCODE_DATA_CORRUPTED),
+				 errmsg("invalid legacy heap page layout")));
+	for (OffsetNumber off = FirstOffsetNumber; off <= maxoff; ++off)
+	{
+		ItemId item = PageGetItemId(page, off);
+		HeapTupleHeader tuple;
+		int length = ItemIdGetLength(item);
+		int offset = ItemIdGetOffset(item);
+
+		if (!ItemIdHasStorage(item))
+			continue;
+		if (!ItemIdIsNormal(item) || length < SizeofHeapTupleHeader ||
+			offset != MAXALIGN(offset) || offset < header->pd_upper ||
+			offset + MAXALIGN(length) > header->pd_special)
+			ereport(ERROR,
+					(errcode(ERRCODE_DATA_CORRUPTED),
+					 errmsg("invalid legacy tuple storage at offset %u", off)));
+		tuple = (HeapTupleHeader) PageGetItem(page, item);
+		if (tuple->t_hoff < SizeofHeapTupleHeader || tuple->t_hoff > length)
+			ereport(ERROR,
+					(errcode(ERRCODE_DATA_CORRUPTED),
+					 errmsg("invalid legacy tuple header at offset %u", off)));
+		items[nitems].itemoff = offset;
+		items[nitems++].alignedlen = MAXALIGN(length);
+	}
+	qsort(items, nitems, sizeof(ItemIdCompactData), itemoffcompare);
+	for (int i = 0; i < nitems; ++i)
+	{
+		if (items[i].itemoff + items[i].alignedlen > upper)
+			ereport(ERROR,
+					(errcode(ERRCODE_DATA_CORRUPTED),
+					 errmsg("overlapping legacy tuple storage")));
+		upper = items[i].itemoff;
+	}
+}
