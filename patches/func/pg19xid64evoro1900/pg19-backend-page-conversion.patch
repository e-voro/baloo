 		if (try_double_xmax &&
 			HeapTupleSatisfiesVacuum(&tuple,
@@ -437,10 +480,6 @@ repack_heap_tuples(RelationExtraData *rel_extra, RelFileLocator *relfilelocator,
 			if (unlikely(itemPtr->itemoff < hdr->pd_upper ||
 						 itemPtr->itemoff >= hdr->pd_special))
 			{
-			/*
-			 * EVoro: To-do: avoid exceptions (ereporting) on the AIO worker's
