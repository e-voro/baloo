-{ name => 'autovacuum_multixact_freeze_max_age', type => 'int64', context => 'PGC_POSTMASTER', group => 'VACUUM_AUTOVACUUM',
+{ name => 'autovacuum_multixact_freeze_max_age', type => 'int_64', context => 'PGC_POSTMASTER', group => 'VACUUM_AUTOVACUUM',
