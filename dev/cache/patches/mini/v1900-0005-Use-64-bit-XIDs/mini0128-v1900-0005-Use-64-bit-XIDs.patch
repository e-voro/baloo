+/*
+ * Rewrite a moved auxiliary fork without modifying its original file until
+ * the replacement is complete.  The caller synchronizes the directory after
+ * all replacements; newly written files must be synchronized before rename.
+ */
+static void
+rewrite_swap_fork(FileNameMap *map, const char *new_db_dir, const char *fork)
+{
+	for (int segno = 0;; segno++)
+	{
+		char	   *path,
+				   *temporary;
+		struct stat st;
+
+		if (segno == 0)
+			path = psprintf("%s/%u%s", new_db_dir, map->relfilenumber, fork);
+		else
+			path = psprintf("%s/%u%s.%d", new_db_dir, map->relfilenumber, fork, segno);
+		if (stat(path, &st) != 0)
+		{
+			if (errno != ENOENT)
+				pg_fatal("could not stat file \"%s\": %m", path);
+			pg_free(path);
+			break;
+		}
+		if (st.st_size == 0)
+		{
+			pg_free(path);
+			continue;
+		}
+
+		temporary = psprintf("%s.pg_upgrade", path);
+		updateSegmentPagesVersion(path, temporary, map->nspname, map->relname,
+								  (BlockNumber) segno * new_cluster.controldata.largesz);
+		if (user_opts.do_sync && fsync_fname(temporary, false) != 0)
+			pg_fatal("could not synchronize file \"%s\": %m", temporary);
+		if (rename(temporary, path) != 0)
+			pg_fatal("could not rename file \"%s\" to \"%s\": %m", temporary, path);
+		pg_free(temporary);
+		pg_free(path);
+	}
+}
+
+/* Process only mapped user relations in the database/tablespace just moved. */
+static void
+rewrite_swap_auxiliary_files(FileNameMap *maps, int size, const char *new_db_dir)
+{
+	for (int i = 0; i < size; i++)
+	{
+		FileNameMap *map = &maps[i];
+		char	   *mapped_dir = psprintf("%s%s/%u", map->new_tablespace,
+										  map->new_tablespace_suffix, map->db_oid);
+
+		if (strcmp(mapped_dir, new_db_dir) == 0)
+		{
+			rewrite_swap_fork(map, new_db_dir, "_fsm");
+			rewrite_swap_fork(map, new_db_dir, "_vm");
+		}
+		pg_free(mapped_dir);
+	}
+}
