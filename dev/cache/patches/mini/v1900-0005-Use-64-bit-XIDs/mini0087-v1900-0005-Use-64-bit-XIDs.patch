+/*
+ * Track a format conversion that must be covered by a full image in WAL.
+ * During read completion the AIO subsystem owns the buffer until BM_VALID
+ * is published, so the completing process need not have a private pin.
+ */
+void
+MarkBufferConverted(Buffer buffer, bool converted)
+{
+	BufferDesc *bufHdr;
+	uint64		buf_state;
+
+	Assert(BufferIsValid(buffer) && !BufferIsLocal(buffer));
+	bufHdr = GetBufferDescriptor(buffer - 1);
+	buf_state = pg_atomic_read_u64(&bufHdr->state);
+	Assert(!converted ||
+		   ((buf_state & BM_IO_IN_PROGRESS) && !(buf_state & BM_VALID)) ||
+		   BufferLockHeldByMe(bufHdr));
+
+	if (((buf_state & BM_CONVERTED) != 0) == converted)
+		return;
+
+	buf_state = LockBufHdr(bufHdr);
+	UnlockBufHdrExt(bufHdr, buf_state,
+					converted ? BM_CONVERTED : 0,
+					converted ? 0 : BM_CONVERTED, 0);
+}
+
+bool
+IsBufferConverted(Buffer buffer)
+{
+	BufferDesc *bufHdr;
+
+	Assert(BufferIsValid(buffer) && !BufferIsLocal(buffer));
+	Assert(BufferIsPinned(buffer));
+	bufHdr = GetBufferDescriptor(buffer - 1);
+	return (pg_atomic_read_u64(&bufHdr->state) & BM_CONVERTED) != 0;
+}
+
+bool
+IsBufferLocked(Buffer buffer)
+{
+	return buffer == InvalidBuffer || BufferIsLockedByMe(buffer);
+}
+
+bool
+IsBufferLockedExclusive(Buffer buffer)
+{
+	return buffer == InvalidBuffer ||
+		BufferIsLockedByMeInMode(buffer, BUFFER_LOCK_EXCLUSIVE);
+}
+
 /*
  * Release buffer content locks for shared buffers.
  *
@@ -8692,6 +8759,33 @@ buffer_readv_complete_one(PgAioTargetData *td, uint8 buf_off, Buffer buffer,
 		}
 	}
 
+	/*
+	 * Convert before publishing BM_VALID.  The AIO pin and IO_IN_PROGRESS
+	 * give this read exclusive access to the invalid buffer.  A shared
+	 * completion callback cannot use the issuer's private pin or relcache.
+	 */
+	if (!failed &&
+		PageGetPageLayoutVersion((Page) bufdata) != 0 &&
+		PageGetPageLayoutVersion((Page) bufdata) != PG_PAGE_LAYOUT_VERSION &&
+		!PageIsNew((Page) bufdata))
+	{
+		Assert(!is_temp);
+		if (tag.forkNum != MAIN_FORKNUM)
+		{
+			RelPathStr path = relpathbackend(td->smgr.rlocator,
+												 INVALID_PROC_NUMBER, tag.forkNum);
+
+			/* TODO: propagate conversion errors through the AIO result. */
+			ereport(ERROR,
+					(errcode(ERRCODE_DATA_CORRUPTED),
+					 errmsg("invalid fork type (%d) in block %u of relation %s",
+							tag.forkNum, tag.blockNum, path.str)));
+		}
+
+		convert_page(&td->smgr.relextradata, &td->smgr.rlocator,
+					 tag.forkNum, (Page) bufdata, buffer, tag.blockNum);
+	}
+
 	/* Terminate I/O and set BM_VALID. */
 	set_flag_bits = failed ? BM_IO_ERROR : BM_VALID;
 	if (is_temp)
