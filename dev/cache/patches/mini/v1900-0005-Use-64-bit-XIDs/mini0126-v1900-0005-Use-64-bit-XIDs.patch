+/*
+ * Preserve each restored source horizon while mapping a wrapped MXID range
+ * to the same full IDs written by rewrite_multixacts().  Initdb horizons
+ * already contain destination IDs and are excluded by the range predicate.
+ */
+static void
+adjust_multixact_horizons(void)
+{
+	PGconn	   *template_conn;
+	PGresult   *databases;
+	uint64		oldest = old_cluster.controldata.chkpnt_oldstMulti;
+
+	if (new_cluster.controldata.chkpnt_nxtmulti <= PG_UINT32_MAX)
+		return;
+
+	prep_status("Expanding wrapped MultiXact horizons");
+	template_conn = connectToServer(&new_cluster, "template1");
+	PQclear(executeQueryOrDie(template_conn,
+							  "UPDATE pg_catalog.pg_database "
+							  "SET datminmxid = ((datminmxid::text::bigint + 4294967295)::text)::pg_catalog.xid "
+							  "WHERE datminmxid::text::bigint > 0 "
+							  "AND datminmxid::text::bigint < %llu",
+							  (unsigned long long) oldest));
+	databases = executeQueryOrDie(template_conn,
+								 "SELECT datname, datallowconn FROM pg_catalog.pg_database");
+	for (int i = 0; i < PQntuples(databases); i++)
+	{
+		char	   *name = PQgetvalue(databases, i, 0);
+		bool		allow = strcmp(PQgetvalue(databases, i, 1), "t") == 0;
+		PGconn	   *conn;
+
+		if (!allow)
+			PQclear(executeQueryOrDie(template_conn,
+									  "ALTER DATABASE %s ALLOW_CONNECTIONS = true",
+									  quote_identifier(name)));
+		conn = connectToServer(&new_cluster, name);
+		PQclear(executeQueryOrDie(conn,
+								  "UPDATE pg_catalog.pg_class "
+								  "SET relminmxid = ((relminmxid::text::bigint + 4294967295)::text)::pg_catalog.xid "
+								  "WHERE relminmxid::text::bigint > 0 "
+								  "AND relminmxid::text::bigint < %llu",
+								  (unsigned long long) oldest));
+		PQfinish(conn);
+		if (!allow)
+			PQclear(executeQueryOrDie(template_conn,
+									  "ALTER DATABASE %s ALLOW_CONNECTIONS = false",
+									  quote_identifier(name)));
+	}
+	PQclear(databases);
+	PQfinish(template_conn);
+	check_ok();
+}
